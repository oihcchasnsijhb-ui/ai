# GEMINI_API_KEY: Required only if using direct Gemini API (Firebase AI Logic is preferred).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENAI_API_KEY: Required for live ChatGPT (OpenAI) responses.
# Configure your key via the Secrets panel in AI Studio.
OPENAI_API_KEY=MY_OPENAI_API_KEY

# ANTHROPIC_API_KEY: Required for live Claude (Anthropic) responses.
# Configure your key via the Secrets panel in AI Studio.
ANTHROPIC_API_KEY=MY_ANTHROPIC_API_KEY
